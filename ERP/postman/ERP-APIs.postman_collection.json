          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/banking/statements/lines/10/reconcile?transactionEntryId=100&notes=Manual%20match",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "banking", "statements", "lines", "10", "reconcile"],
              "query": [
                {"key": "transactionEntryId", "value": "100"},
                {"key": "notes", "value": "Manual match"}
              ]
            }
          }
        },
        {
          "name": "Get Reconciliation Report",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/banking/reconciliation/report?bankAccountId=1&fromDate=2025-01-01&toDate=2025-01-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "banking", "reconciliation", "report"],
              "query": [
                {"key": "bankAccountId", "value": "1"},
                {"key": "fromDate", "value": "2025-01-01"},
                {"key": "toDate", "value": "2025-01-31"}
              ]
            }
          }
        },
        {
          "name": "Mark Statement as Reconciled",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/banking/statements/1/mark-reconciled",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "banking", "statements", "1", "mark-reconciled"]
            }
          }
        },
        {
          "name": "Get Unreconciled Transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/banking/unreconciled-transactions?bankAccountId=1&fromDate=2025-01-01&toDate=2025-01-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "banking", "unreconciled-transactions"],
              "query": [
                {"key": "bankAccountId", "value": "1"},
                {"key": "fromDate", "value": "2025-01-01"},
                {"key": "toDate", "value": "2025-01-31"}
              ]
            }
          }
        },
        {
          "name": "Process Reconciliation",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bankAccountId\": 1,\n  \"statementId\": 1,\n  \"matches\": [\n    { \"lineId\": 10, \"transactionEntryId\": 100 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/banking/reconciliation/process",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "banking", "reconciliation", "process"]
            }
          }
        },
        {
          "name": "Get Bank Balance",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/banking/balance/1?asOfDate=2025-01-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "banking", "balance", "1"],
              "query": [
                {"key": "asOfDate", "value": "2025-01-31"}
              ]
            }
          }
        },
        {
          "name": "Update Bank Balance",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/banking/balance/1/update?asOfDate=2025-01-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "banking", "balance", "1", "update"],
              "query": [
                {"key": "asOfDate", "value": "2025-01-31"}
              ]
            }
          }
        },
        {
          "name": "Export Reconciliation Report",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/banking/reconciliation/export?bankAccountId=1&fromDate=2025-01-01&toDate=2025-01-31&format=PDF",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "banking", "reconciliation", "export"],
              "query": [
                {"key": "bankAccountId", "value": "1"},
                {"key": "fromDate", "value": "2025-01-01"},
                {"key": "toDate", "value": "2025-01-31"},
                {"key": "format", "value": "PDF"}
              ]
            }
          }
        }
      ]
    },
