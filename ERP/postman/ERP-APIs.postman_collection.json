{
  "info": {
    "name": "ERP Banking & Financial Reports APIs",
    "_postman_id": "b0e8f03f-3e6e-4c02-9b73-erp-apis",
    "description": "Postman collection to exercise Banking and Financial Reports endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Banking",
      "item": [
        {
          "name": "Import Bank Statement (file)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "bankAccountId", "value": "1", "type": "text" },
                { "key": "statementDate", "value": "2025-01-31", "type": "text" },
                { "key": "file", "type": "file", "src": [] },
                { "key": "importSource", "value": "CSV", "type": "text" },
                { "key": "notes", "value": "January statement", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/banking/statements/import",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "banking", "statements", "import"]
            }
          }
        },
        {
          "name": "Create Manual Bank Statement",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/banking/statements/manual?bankAccountId=1&statementDate=2025-01-31&openingBalance=1000.00&closingBalance=1500.00",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "banking", "statements", "manual"],
              "query": [
                {"key": "bankAccountId", "value": "1"},
                {"key": "statementDate", "value": "2025-01-31"},
                {"key": "openingBalance", "value": "1000.00"},
                {"key": "closingBalance", "value": "1500.00"}
              ]
            }
          }
        },
        {
          "name": "Get Bank Statement",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/banking/statements/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "banking", "statements", "1"]
            }
          }
        },
        {
          "name": "Get Bank Statements by Account",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/banking/statements/account/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "banking", "statements", "account", "1"]
            }
          }
        },
